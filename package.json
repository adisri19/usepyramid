{
  "name": "pyramid",
  "version": "1.0.0",
  "description": "Pyramid Task Management System Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev": "npx concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build": "npm run build -w packages/shared-types && npm run build:api && npm run build:web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
